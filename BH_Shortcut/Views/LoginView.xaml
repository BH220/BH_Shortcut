<ui:FluentWindow x:Class="BH_Shortcut.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:BH_Shortcut.Views"
        mc:Ignorable="d"
        Title="로그인"
        Width="380" Height="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="2,12,0,4" />
        </Style>
    </ui:FluentWindow.Resources>

    <!-- Esc = 취소 -->
    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </ui:FluentWindow.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="로그인" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Person24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="24,4,24,24">
            <ui:TextBlock FontTypography="Body" Appearance="Secondary"
                          Text="온라인 업로드·다운로드를 하려면 로그인이 필요합니다." TextWrapping="Wrap" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="아이디" />
            <ui:TextBox Icon="{ui:SymbolIcon Person24}"
                        PlaceholderText="아이디"
                        ClearButtonEnabled="False"
                        Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="비밀번호" />
            <ui:PasswordBox Icon="{ui:SymbolIcon LockClosed24}"
                            PlaceholderText="비밀번호"
                            RevealButtonEnabled="True"
                            Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <!-- 입력 오류 안내 -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       FontSize="12" Margin="2,8,0,0" TextWrapping="Wrap"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" Content="로그인" Appearance="Primary"
                           HorizontalAlignment="Stretch" IsDefault="True"
                           Command="{Binding LoginCommand}" />
                <ui:Button Grid.Column="2" Content="취소"
                           HorizontalAlignment="Stretch"
                           Command="{Binding CancelCommand}" />
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>

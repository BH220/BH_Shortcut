<ui:FluentWindow
    x:Class="BH_Shortcut.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BH_Shortcut.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="BH Shortcut"
    Width="980"
    Height="580"
    MinWidth="820"
    MinHeight="480"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    mc:Ignorable="d">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--  입력란 위에 붙는 작은 라벨. ui:TextBlock 은 FontTypography 를 Style 로 주면 Style 이 통째로 교체되므로 일반 TextBlock 을 쓴다  -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="2,12,0,4" />
        </Style>

        <!--  목록 헤더: 배경 + 굵은 글씨 + 아래 구분선. 정렬 화살표와 열 너비 조절 그립 포함  -->
        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="SortArrow"
                                    Grid.Column="1"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Thumb
                                    x:Name="PART_RightHeaderGripper"
                                    Grid.ColumnSpan="2"
                                    Width="8"
                                    Margin="0,0,-12,0"
                                    HorizontalAlignment="Right"
                                    Cursor="SizeWE">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Rectangle Fill="Transparent" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortArrow" Property="Text" Value="▲" />
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortArrow" Property="Text" Value="▼" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  목록 행: 아래 구분선 + 교대 배경 + 호버 + 선택(강조색)  -->
        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="MinHeight" Value="40" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  목록 셀: 기본 셀 선택색(파란 박스)·포커스 테두리를 없애고 행 배경만 보이게  -->
        <Style x:Key="GridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  목록 셀 텍스트: 세로 가운데 + 좌우 여백. 글자색은 행(선택 시 흰색)을 따른다  -->
        <Style x:Key="GridCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="BH Shortcut" Grid.Row="0">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Keyboard24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  제목 줄: 왼쪽 "목록" + 새 명령(우측), 오른쪽 "상세 정보". 같은 행이라 높이가 맞는다  -->
            <Grid
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,0,12">
                <ui:TextBlock
                    VerticalAlignment="Center"
                    FontTypography="Subtitle"
                    Text="목록" />
                <ui:Button
                    HorizontalAlignment="Right"
                    Appearance="Primary"
                    Command="{Binding NewItemCommand}"
                    Content="새 명령"
                    Icon="{ui:SymbolIcon Add24}" />
            </Grid>
            <ui:TextBlock
                Grid.Row="0"
                Grid.Column="2"
                Margin="0,0,0,12"
                VerticalAlignment="Center"
                FontTypography="Subtitle"
                Text="상세 정보" />

            <!--  왼쪽: 목록 + 업로드/다운로드(하단)  -->
            <Grid Grid.Row="1" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="1"
                    Margin="0,12,0,0"
                    Orientation="Horizontal">
                    <ui:DropDownButton
                        Margin="0,0,8,0"
                        Content="업로드"
                        Icon="{ui:SymbolIcon ArrowUpload24}">
                        <ui:DropDownButton.Flyout>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem
                                    Command="{Binding UploadOnlineCommand}"
                                    Header="온라인"
                                    Icon="{ui:SymbolIcon Cloud24}" />
                                <MenuItem
                                    Command="{Binding UploadOfflineCommand}"
                                    Header="오프라인"
                                    Icon="{ui:SymbolIcon CloudOff24}" />
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>

                    <ui:DropDownButton Content="다운로드" Icon="{ui:SymbolIcon ArrowDownload24}">
                        <ui:DropDownButton.Flyout>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem
                                    Command="{Binding DownloadOnlineCommand}"
                                    Header="온라인"
                                    Icon="{ui:SymbolIcon Cloud24}" />
                                <MenuItem
                                    Command="{Binding DownloadOfflineCommand}"
                                    Header="오프라인"
                                    Icon="{ui:SymbolIcon CloudOff24}" />
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>

                    <!--  로그인 정보 [아이디(이름)] + 로그아웃 링크. 로그인한 동안만 보인다  -->
                    <StackPanel
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
                        <TextBlock VerticalAlignment="Center" Text="{Binding LoginText}" />
                        <ui:HyperlinkButton
                            Margin="4,0,0,0"
                            Padding="4,2"
                            VerticalAlignment="Center"
                            Command="{Binding LogoutCommand}"
                            Content="로그아웃" />
                    </StackPanel>
                </StackPanel>

                <ui:DataGrid
                    Grid.Row="0"
                    AlternationCount="2"
                    AutoGenerateColumns="False"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CanUserAddRows="False"
                    CanUserResizeRows="False"
                    CellStyle="{StaticResource GridCellStyle}"
                    ColumnHeaderHeight="40"
                    ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                    GridLinesVisibility="None"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding Items}"
                    RowHeight="40"
                    RowStyle="{StaticResource GridRowStyle}"
                    SelectedItem="{Binding SelectedItem}"
                    SelectionMode="Single">
                    <ui:DataGrid.Columns>
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding KindText}"
                            ElementStyle="{StaticResource GridCellText}"
                            Header="구분" />
                        <DataGridTextColumn
                            Width="140"
                            Binding="{Binding ShortName}"
                            ElementStyle="{StaticResource GridCellText}"
                            Header="단축명" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding ProgramName}"
                            ElementStyle="{StaticResource GridCellText}"
                            Header="프로그램명" />
                    </ui:DataGrid.Columns>
                </ui:DataGrid>
            </Grid>

            <!--  오른쪽: 상세 정보. 내용을 위에서부터 채우도록 세로 Stretch (기본값은 Center)  -->
            <ui:Card
                Grid.Row="1"
                Grid.Column="2"
                Padding="16"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch">
                <DockPanel>
                    <!--  공통: 삭제(왼쪽) / 저장(오른쪽)  -->
                    <Grid Margin="0,16,0,0" DockPanel.Dock="Bottom">
                        <ui:Button
                            HorizontalAlignment="Left"
                            Command="{Binding DeleteCommand}"
                            Content="삭제"
                            Icon="{ui:SymbolIcon Delete24}" />
                        <ui:Button
                            HorizontalAlignment="Right"
                            Appearance="Primary"
                            Command="{Binding SaveCommand}"
                            Content="저장"
                            Icon="{ui:SymbolIcon Save24}" />
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel.Style>
                                <!--  세로 스크롤바가 떠 있을 때만 오른쪽 여백을 주어 컨트롤이 가려지지 않게  -->
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ComputedVerticalScrollBarVisibility, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Value="Visible">
                                            <Setter Property="Margin" Value="0,0,14,0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <!--  공통: 단축명 / 프로그램명 / 구분  -->
                            <TextBlock Style="{StaticResource FieldLabel}" Text="단축명" />
                            <ui:TextBox
                                ClearButtonEnabled="False"
                                Icon="{ui:SymbolIcon Keyboard24}"
                                PlaceholderText="예: dev"
                                Text="{Binding Editing.ShortName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="프로그램명" />
                            <ui:TextBox
                                ClearButtonEnabled="False"
                                Icon="{ui:SymbolIcon Apps24}"
                                PlaceholderText="목록에 표시할 이름"
                                Text="{Binding Editing.ProgramName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="구분" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton
                                    Margin="0,0,16,0"
                                    Content="원격연결"
                                    GroupName="Kind"
                                    IsChecked="{Binding Editing.IsRemote}" />
                                <RadioButton
                                    Content="프로그램"
                                    GroupName="Kind"
                                    IsChecked="{Binding Editing.IsProgram}" />
                            </StackPanel>

                            <!--  구분 = 원격연결  -->
                            <StackPanel Visibility="{Binding Editing.IsRemote, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="주소" />
                                <ui:TextBox
                                    ClearButtonEnabled="False"
                                    Icon="{ui:SymbolIcon Desktop24}"
                                    PlaceholderText="예: 192.168.0.10"
                                    Text="{Binding Editing.Address, UpdateSourceTrigger=PropertyChanged}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Style="{StaticResource FieldLabel}"
                                        Text="포트" />
                                    <ui:NumberBox
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        ClearButtonEnabled="False"
                                        MaxDecimalPlaces="0"
                                        Maximum="65535"
                                        Minimum="1"
                                        SpinButtonPlacementMode="Hidden"
                                        Value="{Binding Editing.Port, Mode=TwoWay}" />

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Style="{StaticResource FieldLabel}"
                                        Text="가로크기" />
                                    <ui:NumberBox
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        ClearButtonEnabled="False"
                                        MaxDecimalPlaces="0"
                                        Maximum="7680"
                                        Minimum="0"
                                        SpinButtonPlacementMode="Hidden"
                                        Value="{Binding Editing.Width, Mode=TwoWay}" />

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="4"
                                        Style="{StaticResource FieldLabel}"
                                        Text="세로크기" />
                                    <ui:NumberBox
                                        Grid.Row="1"
                                        Grid.Column="4"
                                        ClearButtonEnabled="False"
                                        MaxDecimalPlaces="0"
                                        Maximum="4320"
                                        Minimum="0"
                                        SpinButtonPlacementMode="Hidden"
                                        Value="{Binding Editing.Height, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>

                            <!--  구분 = 프로그램  -->
                            <StackPanel Visibility="{Binding Editing.IsProgram, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="파일 경로" />
                                <!--  전체 경로(최대 260자)가 줄바꿈되어 모두 보이도록 여러 줄 + 고정 높이. 아이콘은 가로 폭을 먹으므로 뺀다  -->
                                <ui:TextBox
                                    Height="170"
                                    VerticalContentAlignment="Top"
                                    AcceptsReturn="False"
                                    ClearButtonEnabled="False"
                                    IsReadOnly="True"
                                    PlaceholderText="실행 파일을 선택하세요"
                                    Text="{Binding Editing.FilePath, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto" />
                                <ui:Button
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Right"
                                    Command="{Binding SelectFileCommand}"
                                    Content="찾아보기"
                                    Icon="{ui:SymbolIcon FolderOpen24}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </ui:Card>
        </Grid>
    </Grid>
</ui:FluentWindow>
